import sqlite3

# Connect to the database
conn = sqlite3.connect('finance_dw.db')
cursor = conn.cursor()
cursor.execute("DELETE FROM staging_transactions")

# 1. Create the table
cursor.execute('''
    CREATE TABLE IF NOT EXISTS staging_transactions (
        id INTEGER PRIMARY KEY,
        date TEXT,
        vendor TEXT,
        amount REAL
    )
''')

# 2. Sample Data (Simulating the 'Extract' part)
sample_data = [
    ('2024-03-01', 'Starbucks', 5.50),
    ('2024-03-02', 'Amazon', 45.00),
    ('2024-03-03', 'Apple Music', 10.99)
]

# 3. Insert data into the table (The 'Load' part)
cursor.executemany('''
    INSERT INTO staging_transactions (date, vendor, amount) 
    VALUES (?, ?, ?)
''', sample_data)

conn.commit()
conn.close()
print("Data loaded successfully!")

